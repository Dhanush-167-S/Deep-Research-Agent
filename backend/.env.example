# ============================================================
# TopResearch Backend Environment Configuration
# ============================================================

PROJECT_NAME="TopResearch"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ============================================================
# Database - PostgreSQL + pgvector
# ============================================================

POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="topresearch_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

DATABASE_URL="postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/topresearch_db"

# ============================================================
# LLM Providers - Gemini Primary / Groq Fallback
# ============================================================

DEFAULT_LLM_PROVIDER="gemini"

# Primary LLM
DEFAULT_MODEL_NAME="gemini-2.5-flash"

# Fallback LLM
GROQ_MODEL_NAME="llama-3.3-70b-versatile"

GEMINI_API_KEY="your_gemini_api_key"
GROQ_API_KEY="your_groq_api_key"

# ============================================================
# Web Search - Tavily
# ============================================================

TAVILY_API_KEY="your_tavily_api_key"

# ============================================================
# Embeddings - Hugging Face Inference API
# ============================================================

HF_TOKEN="your_huggingface_token"
HF_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# ============================================================
# Application Security
# ============================================================

SECRET_KEY="your_secure_application_secret"
BETTER_AUTH_SECRET="your_better_auth_secret"

# ============================================================
# Authentication - Better Auth
# ============================================================

BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ============================================================
# CORS
# ============================================================

BACKEND_CORS_ORIGINS='["http://localhost:3000"]'